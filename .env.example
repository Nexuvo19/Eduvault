# MySQL connection. For Aiven, create the eduvault database in its console first.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=eduvault
DB_CONNECT_TIMEOUT=10
# Optional: path to the provider CA certificate (recommended for hosted MySQL).
# Example: DB_SSL_CA=C:/path/to/ca.pem
DB_SSL_CA=
# Set true only if you want init_db.py to create the database (local MySQL).
# For Aiven, create the database in its console and set this to false.
DB_CREATE_DATABASE=true

# Generate a long random value before deploying publicly.
SESSION_SECRET=replace-this-with-a-long-random-secret

# Keep false for local HTTP. Set true when deployed behind HTTPS.
COOKIE_SECURE=false
# Optional upload path. On Render persistent storage, use /var/data/uploads.
# Without persistent storage, uploaded files can be lost on redeploy/restart.
UPLOAD_DIR=instance/uploads
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
